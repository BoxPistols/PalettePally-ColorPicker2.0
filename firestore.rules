rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /palettes/{paletteId} {
      // Owner: full access to own palettes
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid;

      // Version history — only the owner of the parent palette can access
      match /versions/{versionId} {
        allow read, write: if request.auth != null
          && request.auth.uid == get(
            /databases/$(database)/documents/palettes/$(paletteId)
          ).data.ownerUid;
      }
    }

    // Public share snapshots, keyed by an unguessable nanoid shareId.
    // `get` only (knowing the shareId), never `list` — so shared palettes
    // cannot be enumerated. The palettes collection above stays owner-only,
    // closing the previous hole where `allow read: if shareId != null` let
    // anyone enumerate every shared palette via a `where('shareId','!=',null)`
    // query. Snapshots are immutable; revoke = delete.
    match /shares/{shareId} {
      allow get: if true;
      // create は「参照先 palette の所有者本人」だけに限定し、permission 値と
      // 書き込めるフィールドも固定する（任意の paletteId/permission/追加フィールドを
      // 持つ公開ドキュメントを認証ユーザーが捏造できないようにする）。
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.ownerUid == get(
          /databases/$(database)/documents/palettes/$(request.resource.data.paletteId)
        ).data.ownerUid
        && request.resource.data.permission in ['view', 'duplicate']
        && request.resource.data.keys().hasOnly(
          ['paletteId', 'ownerUid', 'permission', 'name', 'description', 'data', 'createdAt']
        );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }
  }
}
